{
  "name": "@uptiq/training-sdk-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo root. Publishable packages live in packages/. See individual package READMEs.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json}\" \"packages/*/tests/**/*.{ts,tsx}\" \"content/**/*.json\" \"scripts/**/*.ts\"",
    "dev": "vite",
    "validate:content": "tsx scripts/validate-content.ts content",
    "validate:selectors": "tsx scripts/validate-selectors.ts",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run validate:content && npm run docs:events:check",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,json}\" \"packages/*/tests/**/*.{ts,tsx}\" \"content/**/*.json\" \"scripts/**/*.ts\"",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "docs:events": "tsx scripts/generate-event-dictionary.ts",
    "docs:events:check": "tsx scripts/generate-event-dictionary.ts --check"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}