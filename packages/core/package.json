{
  "name": "@in-app-training/sdk",
  "version": "0.0.1",
  "description": "In-app product training SDK — framework-agnostic core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/v1": {
      "types": "./dist/schema/v1.d.ts",
      "import": "./dist/schema/v1.js"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "shepherd.js": "^14.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.4.0",
    "jsdom": "^24.0.0",
    "vitest": "^1.4.0"
  }
}
